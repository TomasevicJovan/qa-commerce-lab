{
  "name": "qa-commerce-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local e-commerce QA laboratory with independent services and event-driven checkout",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
